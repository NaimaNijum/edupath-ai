APP_NAME=EduPath AI
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://edupath:edupath@localhost:5432/edupath
REDIS_URL=redis://localhost:6379/0

EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# OpenRouter serves both text generation and embeddings. openrouter/free
# auto-routes to whichever free model is currently available. Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Web search is optional. Without it, agents fall back to the curated seed
# catalog (see scripts/seed_catalog.py) and honestly report "unavailable"
# rather than fabricating results.
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=

# Google OAuth -- leave blank to use dev-mock login instead of real Google
# sign-in. Register this exact redirect URI in Google Cloud Console:
#   http://localhost:8000/api/v1/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
FRONTEND_URL=http://localhost:8501

# Generate your own local secret, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
